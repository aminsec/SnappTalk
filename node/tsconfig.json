{
  "compilerOptions": {
    "target": "ES2025",
    "module": "ESNext",
    "moduleDetection": "force",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": ["bun"]
  }
}